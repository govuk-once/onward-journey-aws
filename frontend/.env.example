# Populated from Terraform output: client_websocket_url:
PUBLIC_CLIENT_WEBSOCKET_URL=wss://xxxxxxxx.execute-api.eu-west-2.amazonaws.com/<env_prefix>
# Populated from Terraform output: cognito_identity_pool_id:
PUBLIC_COGNITO_IDENTITY_POOL_ID=eu-west-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Populated from key value of <workspace>/websocket/auth-tokens
PUBLIC_WEBSOCKET_AUTH_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PUBLIC_AWS_REGION=eu-west-2
