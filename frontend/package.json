{
  "name": "govuk-once-onward-journey-frontend",
  "homepage": "https://github.com/govuk-once/onward-journey",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "make prepare || svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier .",
    "lint:fix": "eslint . --fix && prettier . --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.4",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "uuid": "^13.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 26",
    "npm": "^11.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1088.0",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.17",
    "govuk-frontend": "^5.14.0",
    "marked": "^18.1.2",
    "sanitize-html": "^2.17.7"
  }
}
