{
  "name": "govuk-once-onward-journey-frontend",
  "homepage": "https://github.com/govuk-once/onward-journey",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "make prepare || svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier .",
    "lint:fix": "eslint . --fix && prettier . --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26",
    "@types/sanitize-html": "^2.16.1",
    "@types/showdown": "^2.0.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "uuid": "^13.0.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 26",
    "npm": "^11.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1088.0",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.17",
    "govuk-frontend": "^5.14.0",
    "sanitize-html": "^2.18.1",
    "showdown": "^2.1.0"
  }
}
